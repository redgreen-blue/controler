menu "WM8741 Control"

    config I2C_MASTER_SCL
        int "I2C SCL GPIO"
        default 22
        range 0 39

    config I2C_MASTER_SDA
        int "I2C SDA GPIO"
        default 21
        range 0 39

    config I2C_MASTER_FREQUENCY
        int "I2C frequency (Hz)"
        default 100000
        range 1 400000

    config ESP_WIFI_SSID
        string "Wi-Fi SSID"
        default "myssid"

    config ESP_WIFI_PASSWORD
        string "Wi-Fi Password"
        default "mypassword"

    config ESP_WIFI_MAX_RETRY
        int "Wi-Fi max retry"
        default 5

    config UDP_DISCOVER_PORT
        int "UDP discover port"
        default 8888
        range 1024 65535

    config TCP_SERVER_PORT
        int "TCP server port"
        default 8889
        range 1024 65535

endmenu